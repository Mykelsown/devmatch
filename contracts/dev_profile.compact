pragma language_version 0.23;

import CompactStandardLibrary;

export enum Tier { Yellow, Green }

export enum RevealPolicy { ScoreOnly, FieldsOnPolicy, ApprovalRequired }

export ledger profiles: Map<Bytes<32>, Bytes<32>>;
export ledger tiers: Map<Bytes<32>, Tier>;
export ledger revealPolicies: Map<Bytes<32>, RevealPolicy>;

witness localSecretKey(): Bytes<32>;

circuit callerId(): Bytes<32> {
  const sk = localSecretKey();
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "devmatch:caller:"),
    sk
  ]);
}

export circuit registerProfile(
  commitment: Bytes<32>,
  tier: Tier,
  policy: RevealPolicy
): [] {
  const caller = callerId();
  assert (!profiles.member(caller), "Profile already exists for this address");
  profiles.insert(caller, commitment);
  tiers.insert(caller, tier);
  revealPolicies.insert(caller, policy);
}