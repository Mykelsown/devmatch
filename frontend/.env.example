# Copy to `.env` and adjust for your deployment. All vars are optional —
# sensible defaults (Preview network, deployed contract) are baked into
# `src/config.ts`.

# Midnight network id passed to the Lace wallet ('preview' | 'preprod')
VITE_NETWORK_ID=preview

# Address of the deployed DevMatch contract (set after `npm run deploy:preview`)
VITE_CONTRACT_ADDRESS=2ea2f4d440cbffb41e95efeda584cf8df2cdad82997549389e7ebcf9d1f17db5

# Indexer endpoints for the chosen network
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# How proofs are generated:
#   wallet (default) — in-wallet proving via Lace (works on a public deploy)
#   http             — local docker proof server (http://127.0.0.1:6300)
VITE_PROOF_MODE=wallet
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Attester service base URL (GitHub OAuth, Level 3 prep)
VITE_ATTESTER_URL=http://localhost:3001
